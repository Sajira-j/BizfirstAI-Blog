<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/png" href="~/img/favicon.png" />
  <link rel="shortcut icon" type="image/png" href="~/img/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- BizFirst AI Dark Theme Design Tokens -->
  <style>
    :root {
      /* SURFACE TOKENS */
      --surface-0: #0E1113;
      --surface-1: #151A1E;
      --surface-2: #1B2126;
      --surface-3: #222A30;
      --surface-border: #2A3238;

      /* ACCENT TOKENS */
      --accent-1: #1DB954;
      --accent-1-hover: #17A74A;
      --accent-1-active: #148C3E;
      --accent-1-soft: #163D2A;
      --accent-1-glow: rgba(29,185,84,0.25);

      /* TEXT TOKENS */
      --text-1: #E6EDF3;
      --text-2: #9AA4AE;
      --text-3: #6B7680;
      --text-on-accent: #0E1113;

      /* STATUS TOKENS */
      --status-success: #1DB954;
      --status-warning: #F5A524;
      --status-error: #E5484D;
      --status-info: #3B82F6;

      /* FOCUS & EFFECTS */
      --focus-ring: 0 0 0 3px rgba(29,185,84,0.25);
      --card-radius: 12px;
      --button-radius: 8px;

      /* Legacy compatibility */
      --bf-color: var(--accent-1);
      --bf-header-title-size: 1.5rem;
      --bf-header-title-weight: 700;
      --bf-header-title-color: var(--text-1);
      --bf-header-title-hover: var(--accent-1);
      --bf-header-logo-width: auto;
      --bf-header-logo-height: 1.5rem;
      --bf-post-width: 43.75rem;
      --bf-radius: var(--card-radius);
    }
  </style>
  <link rel="stylesheet" href="~/css/custom.css"/>
  @await RenderSectionAsync("HeaderScript", required: false)
</head>

<body>
  @RenderBody()
</body>

</html>
