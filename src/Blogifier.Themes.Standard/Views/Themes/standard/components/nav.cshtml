<script type="text/javascript">
console.log('=== MOBILE MENU SCRIPT STARTED ===');

// Immediate execution
(function() {
  'use strict';

  function initMobileMenu() {
    console.log('initMobileMenu called');
    var toggle = document.getElementById('mobileMenuToggle');
    var menu = document.getElementById('headerNavItems');

    console.log('Toggle:', toggle);
    console.log('Menu:', menu);

    if (!toggle) {
      console.error('Toggle button NOT FOUND!');
      return;
    }
    if (!menu) {
      console.error('Menu container NOT FOUND!');
      return;
    }

    console.log('Both elements found! Attaching click handler...');

    // Remove any existing click handlers
    var newToggle = toggle.cloneNode(true);
    toggle.parentNode.replaceChild(newToggle, toggle);
    toggle = newToggle;

    // Simple click handler
    toggle.addEventListener('click', function(e) {
      console.log('=== BUTTON CLICKED ===');
      e.preventDefault();
      e.stopPropagation();

      var isActive = menu.classList.contains('active');
      console.log('Menu is currently:', isActive ? 'ACTIVE' : 'INACTIVE');

      if (isActive) {
        menu.classList.remove('active');
        console.log('Removed active class');
      } else {
        menu.classList.add('active');
        console.log('Added active class');
      }

      console.log('New classes:', menu.className);
    }, true);

    // Click outside to close
    document.addEventListener('click', function(e) {
      if (!menu.contains(e.target) && !toggle.contains(e.target)) {
        menu.classList.remove('active');
      }
    });

    console.log('=== MOBILE MENU INITIALIZED SUCCESSFULLY ===');
  }

  // Try immediately
  initMobileMenu();

  // Try on DOMContentLoaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      console.log('DOMContentLoaded fired');
      initMobileMenu();
    });
  }

  // Try on window load as backup
  window.addEventListener('load', function() {
    console.log('Window load fired');
    initMobileMenu();
  });

  // Try after delays as backup
  setTimeout(function() {
    console.log('Timeout 100ms');
    initMobileMenu();
  }, 100);

  setTimeout(function() {
    console.log('Timeout 500ms');
    initMobileMenu();
  }, 500);
})();

console.log('=== MOBILE MENU SCRIPT LOADED ===');
</script>
